# Copy to .env and fill in. Never commit .env. Load with: set -a; . ./.env; set +a
# OpenRouter API key (used by planD/llm.py and commit_monitor/src/llm.py)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Alternative: path to a file that contains only the raw key (used if OPENROUTER_API_KEY is unset)
# OPENROUTER_KEY_FILE=/path/to/your/keyfile
# Commit-monitor round-7 sandbox (optional)
# R7_SANDBOX=/tmp/r7sandbox
# PYROOT=/path/to/your/python/install
